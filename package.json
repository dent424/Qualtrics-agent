{
  "name": "qualtrics-bot-agent",
  "version": "0.1.0",
  "description": "Browser automation agent for Qualtrics surveys - bot detection research",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "postinstall": "playwright install chromium",
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "qualtrics",
    "survey",
    "bot",
    "automation",
    "playwright",
    "research"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "playwright": "^1.49.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
